{
  "name": "@tf/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler d1 migrations apply DB --remote && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tf/agent": "workspace:*",
    "@tf/brand": "workspace:*",
    "@tf/engine": "workspace:*",
    "@tf/renderer": "workspace:*",
    "@tf/schema": "workspace:*",
    "@tf/sections": "workspace:*",
    "@tf/templates": "workspace:*",
    "@tf/tokens": "workspace:*",
    "@tf/ui": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^5.1.6",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  }
}
