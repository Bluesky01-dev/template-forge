{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "template-forge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "template-forge",
      "database_id": "638a3d04-fed2-407b-a20a-49c37c8456c1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TF_MODEL": "claude-opus-5-5"
  }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   ANTHROPIC_API_KEY  – enables the AI chat editor
  //   APP_PASSWORD       – protects the dashboard/editor (pitch links stay public)
}
